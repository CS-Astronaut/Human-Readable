---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import PostCard from '../components/PostCard.astro';
import { getAllPosts, getPostsPage, getTotalPages } from '../lib/posts';

// Sort by date (newest first)
const sortedPosts = await getAllPosts();

// Find featured post, fallback to first post
const featuredPost = sortedPosts.find((post) => post.data.featured) || sortedPosts[0];

// Listing = everything except the featured post, newest first
const listing = sortedPosts.filter((post) => post.id !== featuredPost.id);
const totalPages = getTotalPages(listing.length);
const pagePosts = getPostsPage(listing, 1);
---

<Layout title="home">
  <div class="container">
    <!-- Hero Section -->
    <section class="hero">
      <h1 class="hero-title">Human Readable</h1>
      <p class="hero-subtitle">
        manual pages for curious humans!
      </p>
      <div class="hero-divider"></div>
    </section>

{featuredPost && (
    <section class="featured-section">
      <p class="section-label">featured post</p>
      <PostCard post={featuredPost} featured />
    </section>
)}


    <!-- Recent Posts -->
    {pagePosts.length > 0 && (
      <PostList posts={pagePosts} currentPage={1} totalPages={totalPages} baseHref={import.meta.env.BASE_URL} />
    )}

    <!-- Empty State -->
    {sortedPosts.length === 0 && (
      <section class="empty-state">
        <p class="text-dim">no posts yet. check back soon.</p>
      </section>
    )}
  </div>
</Layout>

<style>
  .hero {
    text-align: center;
    margin-bottom: 4rem;
    padding-top: 2rem;
  }

  .hero-title {
    font-family: "Workbench", monospace;
    font-size: clamp(2.25rem, 8vw, 3.5rem);
    margin-bottom: 1rem;
    letter-spacing: 3px;
    text-transform: lowercase;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--color-text-dim);
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-divider {
    height: 2px;
    max-width: 200px;
    margin: 2rem auto;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-primary),
      transparent
    );
  }

  .section-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-text-dim);
    margin-bottom: 1.5rem;
    border-bottom: 1px dotted var(--color-surface-light);
    padding-bottom: 0.75rem;
  }

  .featured-section {
    margin-bottom: 4rem;
  }

  .posts-section {
    margin-bottom: 2rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
  }
</style>
