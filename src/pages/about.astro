---
import Layout from "../layouts/Layout.astro";
import { getImage } from "astro:assets";
import CRTBio from "../components/CRTBio/CRTBio.astro";

import desktopImage from "../assets/slideshow/desktop.webp";
import mobileImage from "../assets/slideshow/mobile.webp";

const desktopBg = await getImage({
  src: desktopImage,
  format: "webp",
  densities: [1, 2],
});
const mobileBg = await getImage({
  src: mobileImage,
  format: "webp",
  densities: [1, 2],
});
---

<Layout title="about">

    <picture>
      <source media="(max-width: 640px)" srcset={mobileBg.src} />
      <source srcset={desktopBg.src} />
      <img
        src={desktopBg.src}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="background"
      />
    </picture>

    <div class="background-overlay"></div>
    <section class="about">
        <div class="terminal-container">
            <CRTBio />
        </div>
    </section>

</Layout>

<style>
:root {
  --terminal-max-width: 960px;
  --page-padding: clamp(1rem, 4vw, 3rem);
}

/* ==========================================
   BACKGROUND
========================================== */

.background {
  position: fixed;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  z-index: -2;

  transform: scale(1.08);

  filter:
    brightness(0.28)
    contrast(1.08)
    saturate(0.65);
}

:global(:root[data-theme="light"]) .background {
  filter:
    brightness(0.55)
    contrast(1.05)
    saturate(0.7);
}

.background-overlay {
  position: fixed;
  inset: 0;

  z-index: -1;
  pointer-events: none;

  background:
    radial-gradient(
      circle at center,
      var(--vignette-soft) 0%,
      var(--vignette) 45%,
      var(--vignette-strong) 100%
    );
}

/* ==========================================
   PAGE
========================================== */

.about {
  position: relative;
  z-index: 1;

  display: flex;
  flex-direction: column;
  overflow: hidden;

  /* main is flex:1 of the 100dvh body, so this section fills exactly
     the space between the site header and the footer */
  height: 100%;
  box-sizing: border-box;

  padding:
    1rem
    var(--page-padding)
    2rem;
}

/* ==========================================
   TERMINAL
========================================== */

.terminal-container {
  position: relative;

  width: min(100%, var(--terminal-max-width));
  /* `auto` margins center safely: when there's spare room vertically and
     horizontally, and never clip the top when space is tight */
  margin-inline: auto;
  margin-block: auto;
}

/* Ambient glow */
.terminal-container::before {
  content: "";

  position: absolute;
  inset: -80px;

  z-index: -1;

  background:
    radial-gradient(
      circle,
      var(--terminal-glow),
      transparent 70%
    );

  filter: blur(80px);
}

/* ==========================================
   LARGE SCREENS
========================================== */

@media (min-width: 1600px) {

  .terminal-container {
    max-width: 1100px;
  }

}

/* ==========================================
   TABLETS
========================================== */

@media (max-width: 900px) {

  .about {
    padding:
      1rem
      1.5rem
      1.5rem;
  }

}

/* ==========================================
   MOBILE
========================================== */

@media (max-width: 640px) {

  .background {
    filter: none;
    transform: scale(1.12);
    object-position: center top;
  }

  .about {
    padding:
      0.75rem
      1rem
      1rem;
  }

  .terminal-container::before {
    inset: -40px;
    background:
      radial-gradient(
        circle,
        var(--terminal-glow-soft),
        var(--terminal-glow-faint) 45%,
        transparent 70%
      );
    filter: none;
  }

}

/* ==========================================
   ONE-VIEWPORT FIT
========================================== */

:global(.site-header) {
  margin-bottom: 0 !important;
}

:global(.footer) {
  margin-top: 0 !important;
}
</style>
