---
import '../styles/colors.css';
import '../styles/theme.css';
import '../styles/katex.min.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: string;
  dir?: "ltr" | "rtl";
}

const { title, description, ogImage, lang = "en", dir = "ltr" } = Astro.props;
---


<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}
      })();
    </script>

    <title>{title} -h</title>

    <meta
      name="description"
      content={description || 'A retro-arcade blog'}
    />

    <!-- Canonical -->
    <link rel="canonical" href={Astro.url.href} />


    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
      href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=VT323&display=swap" rel="stylesheet">

    <style is:global>
      /* Hide the MathML rendering when KaTeX HTML is present to prevent double rendering */
      .katex-mathml {
        display: none !important;
      }
      /* Ensure math elements are always rendered left-to-right (LTR) with left alignment */
      .katex {
        direction: ltr !important;
        unicode-bidi: embed !important;
        text-align: left !important;
      }
      .katex-display {
        direction: ltr !important;
        text-align: center !important;
        overflow-x: auto !important;
        overflow-y: hidden !important;
        -webkit-overflow-scrolling: touch;
      }
    </style>


    <!-- Open Graph -->
    <meta property="og:title" content={`${title} • human readable`} />
    <meta
      property="og:description"
      content={description || 'A retro-arcade blog'}
    />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="human readable" />
    <meta property="og:locale" content="en_US" />

    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:secure_url" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
      </>
    )}

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} • human readable`} />
    <meta
      name="twitter:description"
      content={description || 'A retro-arcade blog'}
    />

    {ogImage && (
      <meta name="twitter:image" content={ogImage} />
    )}

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />



    </head>
    <body>

      <header class="site-header">
        <div class="container">
          <nav class="site-nav">
            <a href={import.meta.env.BASE_URL} class="site-title">
              <span class="bracket">[</span>
              <span class="title-text">-h</span>
              <span class="bracket">]</span>
            </a>
            <ul class="nav-links">
              <li><a href={import.meta.env.BASE_URL}>home</a></li>
              <li><a href={`${import.meta.env.BASE_URL}#posts`}>posts</a></li>
              <li><a href={import.meta.env.BASE_URL + 'about'}>about</a></li>
              <li>
                <button
                  id="theme-toggle"
                  class="theme-toggle"
                  type="button"
                  aria-label="Switch to light theme"
                  title="Toggle theme"
                >
                  <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                  </svg>
                  <svg class="icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                  </svg>
                </button>
              </li>
            </ul>
          </nav>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <Footer 
        github="https://github.com/cs-astronaut"
        linkedin="https://www.linkedin.com/in/amin-farahani-8a6511263/"
        telegram="https://t.me/Astro_Terminal"
      />
    </body>
  </html>

  <script>
    const root = document.documentElement;
    const btn = document.getElementById('theme-toggle');

    function applyTheme(theme) {
      if (theme === 'light') {
        root.setAttribute('data-theme', 'light');
      } else {
        root.removeAttribute('data-theme');
      }
      if (btn) {
        const light = theme === 'light';
        btn.setAttribute('aria-pressed', String(light));
        btn.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
      }
      try {
        localStorage.setItem('theme', theme);
      } catch (e) {}
    }

    if (btn) {
      applyTheme(root.getAttribute('data-theme') || 'dark');
      btn.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        applyTheme(next);
      });
    }
  </script>

  <style>

    /* Layout.astro */
    body {
      display: flex;
      flex-direction: column;
      min-height: 100dvh;
    }

    main {
      flex: 1 0 auto; /* fills remaining space, no overshoot */
    }






    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--color-surface);
      border-bottom: 1px solid var(--header-border);
      padding: 1.2rem 0;
      margin-bottom: 3rem;
      box-shadow: 0 4px 20px var(--shadow);
    }

    /* Frosted-glass blur is GPU-heavy while scrolling on touch devices:
       keep it desktop-only, use a solid header on mobile */
    @media (hover: hover) and (pointer: fine) {
      .site-header {
        background: linear-gradient(
          180deg,
          var(--header-bg-top) 0%,
          var(--header-bg-bottom) 100%
        );
        backdrop-filter: blur(10px);
      }
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .site-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 3rem;
    }

    .site-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.7rem;
      font-weight: 100;
      letter-spacing: 2px;
      text-decoration: none;
      color: var(--color-primary);
      transition: all 0.3s ease;
      flex-shrink: 0;
      text-transform: lowercase;
      text-decoration: none;

    }

    .site-title:hover {
      color: var(--color-accent);
      text-shadow: 0 0 10px var(--title-glow);
    }

    .title-text {
      text-transform: lowercase;
      font-family: "Workbench";
    }

    .bracket {
      color: var(--color-accent-warm);
      font-weight: 900;
      opacity: 0.8;
      font-family: "Workbench";
    }

    .nav-links {
      display: flex;
      list-style: none;
      margin: 0;
      padding: 0;
      gap: 0.5rem;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .nav-links a {
      display: inline-block;
      padding: 0.6rem 1.2rem;
      font-size: 0.95rem;
      color: var(--color-text-dim);
      text-decoration: none;
      text-transform: lowercase;
      letter-spacing: 1px;
      border-radius: 4px;
      transition: all 0.25s ease;
      position: relative;
      border: 1px solid transparent;
    }

    .nav-links a:hover {
      color: var(--color-primary);
      background-color: var(--hover-bg);
      border-color: var(--accent-strong);
      box-shadow: 0 0 12px var(--hover-glow);
    }

    .nav-links a::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
      transform: translateX(-50%);
      transition: width 0.3s ease;
    }

    .nav-links a:hover::before {
      width: 100%;
    }

    .theme-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.6rem 1.2rem;
      font-size: 0.95rem;
      color: var(--color-text-dim);
      background: none;
      border: 1px solid transparent;
      border-radius: 4px;
      cursor: pointer;
      letter-spacing: 1px;
      transition: all 0.25s ease;
    }

    .theme-toggle .icon {
      display: block;
      width: 18px;
      height: 18px;
    }

    .theme-toggle .icon-moon {
      display: none;
    }

    .theme-toggle:hover {
      color: var(--color-primary);
      background-color: var(--hover-bg);
      border-color: var(--accent-strong);
      box-shadow: 0 0 12px var(--hover-glow);
    }

    .theme-toggle:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    :global(:root[data-theme="light"]) .theme-toggle .icon-sun {
      display: none;
    }

    :global(:root[data-theme="light"]) .theme-toggle .icon-moon {
      display: block;
    }

    /* main { */
    /*   min-height: calc(100vh - 300px); */
    /* } */

    @media (max-width: 768px) {
      .site-nav {
        gap: 1.5rem;
      }

      .site-title {
        font-size: 1.3rem;
      }

      .nav-links {
        gap: 0.25rem;
      }

      .nav-links a {
        padding: 0.5rem 0.8rem;
        font-size: 0.85rem;
      }

      .theme-toggle {
        padding: 0.5rem 0.8rem;
      }
    }

    @media (max-width: 640px) {
      .site-header {
        padding: 0.75rem 0;
        margin-bottom: 2rem;
      }

      .site-nav {
        gap: 1rem;
        flex-wrap: nowrap;
      }

      .site-title {
        font-size: 0.95rem;
        gap: 0.3rem;
      }

      .nav-links {
        width: 100%;
        gap: 0.2rem;
        order: 3;
      }

      .nav-links a {
        padding: 0.55rem 0.7rem;
        font-size: 0.8rem;
      }

      .theme-toggle {
        padding: 0.55rem 0.7rem;
      }
    }





  </style>
